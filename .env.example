# Copy to .env for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# Neon pooled connection string (host has "-pooler"). Used by the API.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon direct connection string (no "-pooler"). Used only by `go run ./cmd/admin ...`.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# At least 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=C6dCzIq7N2I8odDKNQGNgHpzEVWZHsYY7ewaQ797MZzL4qG1OWq19Lrq/RnaFxn0

# Optional
# Max token lifetime. Tokens also never outlive the account (users.expires_at).
JWT_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
DB_MAX_CONNECTIONS=5
PORT=8080
# debug, info, warn or error. debug also logs every request.
LOG_LEVEL=info
